{
  "name": "medusa-plugin-printify",
  "version": "0.3.0",
  "description": "Printify print-on-demand integration plugin for Medusa v2",
  "author": "Dawson Blackhouse",
  "license": "MIT",
  "homepage": "https://github.com/greedychipmunk/medusa-plugin-printify#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/greedychipmunk/medusa-plugin-printify.git"
  },
  "bugs": {
    "url": "https://github.com/greedychipmunk/medusa-plugin-printify/issues"
  },
  "files": [
    ".medusa/server"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./workflows": "./.medusa/server/src/workflows/index.js",
    "./.medusa/server/src/modules/*": "./.medusa/server/src/modules/*/index.js",
    "./modules/*": "./.medusa/server/src/modules/*/index.js",
    "./providers/*": "./.medusa/server/src/providers/*/index.js",
    "./*": "./.medusa/server/src/*.js",
    "./admin": {
      "import": "./.medusa/server/src/admin/index.mjs",
      "require": "./.medusa/server/src/admin/index.js",
      "default": "./.medusa/server/src/admin/index.js"
    }
  },
  "keywords": [
    "medusa",
    "medusa-v2",
    "medusa-plugin",
    "medusa-plugin-other",
    "printify",
    "print-on-demand",
    "pod",
    "dropshipping",
    "ecommerce",
    "fulfillment",
    "webhooks"
  ],
  "scripts": {
    "build": "medusa plugin:build",
    "dev": "medusa plugin:develop",
    "prepublishOnly": "medusa plugin:build",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "devDependencies": {
    "@medusajs/admin-sdk": "2.13.1",
    "@medusajs/cli": "2.13.1",
    "@medusajs/framework": "2.13.1",
    "@medusajs/icons": "2.13.1",
    "@medusajs/medusa": "2.13.1",
    "@medusajs/test-utils": "2.13.1",
    "@medusajs/ui": "4.1.1",
    "@swc/core": "^1.7.28",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.2.25",
    "jest": "^30.2.0",
    "jest-mock-extended": "^4.0.0",
    "prop-types": "^15.8.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "vite": "^5.2.11",
    "yalc": "^1.0.0-pre.53"
  },
  "peerDependencies": {
    "@medusajs/admin-sdk": "^2.12.4",
    "@medusajs/cli": "^2.12.4",
    "@medusajs/framework": "^2.12.4",
    "@medusajs/icons": "^2.12.4",
    "@medusajs/medusa": "^2.12.4",
    "@medusajs/test-utils": "^2.12.4",
    "@medusajs/ui": "^4.0.25"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "axios": "^1.13.6"
  },
  "packageManager": "pnpm@10.18.3+sha1.0202a20aaa3d7ba8bc29b50d95efe1a34dd95773"
}
