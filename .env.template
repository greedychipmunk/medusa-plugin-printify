# Printify API Configuration
PRINTIFY_API_KEY=your_printify_api_key_here
PRINTIFY_SHOP_ID=your_printify_shop_id_here

# Webhook Configuration
PRINTIFY_WEBHOOK_SECRET=your_webhook_secret_here
PRINTIFY_WEBHOOK_URL=https://your-domain.com/webhooks/printify

# Database Configuration (inherits from Medusa)
# DATABASE_URL is automatically provided by Medusa

# Plugin Configuration
PRINTIFY_SYNC_ENABLED=true
PRINTIFY_SYNC_FREQUENCY_MINUTES=60
PRINTIFY_API_TIMEOUT_MS=10000

# Development/Testing
NODE_ENV=development
LOG_LEVEL=debug