# Database Configuration (required for plugin:db:generate)
DATABASE_URL="postgres://medusa_user:medusa_password@localhost:5432/medusa_db"
POSTGRES_USER=medusa_user
POSTGRES_PASSWORD=medusa_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=medusa_db
DB_USERNAME=medusa_user
DB_PASSWORD=medusa_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=medusa_db

# Printify API Configuration
# Generate a personal access token at: https://printify.com/app/account/api
PRINTIFY_API_KEY=your_printify_personal_access_token
# Find your shop ID by calling: GET https://api.printify.com/v1/shops.json
PRINTIFY_SHOP_ID=your_printify_shop_id

# Webhook Configuration
# A secret string you choose — Printify uses it to sign webhook payloads
PRINTIFY_WEBHOOK_SECRET=your_webhook_secret
# Base URL of your Medusa server, no trailing slash (e.g. https://api.mystore.com)
PRINTIFY_WEBHOOK_URL=https://your-domain.com

# Plugin Configuration (optional)
PRINTIFY_SYNC_ENABLED=true
PRINTIFY_SYNC_FREQUENCY_MINUTES=60
PRINTIFY_API_TIMEOUT_MS=10000

# Development/Testing
NODE_ENV=development
LOG_LEVEL=debug
